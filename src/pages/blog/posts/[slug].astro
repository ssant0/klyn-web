---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const relatedFor = (current: (typeof posts)[number]) =>
    posts
      .filter((p) => p.id !== current.id)
      .map((p) => {
        const sharedTags = (p.data.tags ?? []).filter((t) => (current.data.tags ?? []).includes(t)).length;
        const sameCategory = p.data.category === current.data.category ? 2 : 0;
        return { post: p, score: sharedTags + sameCategory };
      })
      .filter((entry) => entry.score > 0)
      .sort(
        (a, b) =>
          b.score - a.score ||
          b.post.data.datePublished.getTime() - a.post.data.datePublished.getTime(),
      )
      .slice(0, 3)
      .map((entry) => entry.post);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedFor(post) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  limpieza: 'Limpieza',
  papeleria: 'Papelería',
  industrias: 'Industrias',
  guias: 'Guías',
};
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  article={{
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.datePublished.toISOString(),
    dateModified: post.data.dateModified?.toISOString(),
    author: post.data.author,
    image: post.data.image,
    tags: post.data.tags,
    category: post.data.category,
  }}
>
  <section class="py-10 py-md-13" style="background: #f5f9ff;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
          <p class="small text-body-secondary mb-2">
            {post.data.datePublished.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
            {post.data.tags && post.data.tags.length > 0 && (
              <> · {post.data.tags.map((t) => <span class="badge bg-light text-dark me-1">{t}</span>)}</>
            )}
          </p>
          <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white" style="width:42px;height:42px;background:#6cace3;font-size:1rem;flex-shrink:0;">
              {post.data.author.split(' ').map((w) => w[0]).slice(0, 2).join('')}
            </span>
            <div>
              <p class="mb-0 fw-bold text-dark" style="font-size:0.92rem;">{post.data.author}</p>
              <p class="mb-0 text-body-secondary" style="font-size:0.8rem;">Socio · Ventas y distribución en Klyn</p>
            </div>
          </div>
          <h1 class="fw-bold text-dark mb-4" style="font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: -0.02em;">
            {post.data.title}
          </h1>

          {post.data.image && (
            <picture class="blog-hero">
              <source srcset={post.data.image.replace(/\.(jpe?g|png)$/i, '.webp')} type="image/webp" />
              <img
                src={post.data.image}
                alt={post.data.title}
                width="1200"
                height="630"
                class="img-fluid mb-5"
                data-aos="fade-up"
                style="border-radius: 1rem; box-shadow: 0 8px 40px rgba(0,0,0,0.10); width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block;"
              />
            </picture>
          )}

          <div class="blog-content">
            <Content />
          </div>

          <hr class="my-6" />

          <div class="text-center">
            <a href="/blog/" class="btn btn-outline-secondary rounded-pill px-5" style="border-radius: 999px;">
              <i class="fe fe-arrow-left me-2"></i> Volver al blog
            </a>
            <a href="/contacto/" class="btn fw-bold text-white ms-2 rounded-pill px-5" style="background-color: #6cace3; border-radius: 999px;">
              Cotizar productos <i class="fe fe-arrow-right ms-2"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-10 py-md-13" style="background: #ffffff; border-top: 1px solid #e8eef7;">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-12 col-lg-8">
            <span class="section-eyebrow eyebrow-blue">Sigue leyendo</span>
            <h2 class="fw-bold text-dark mb-6" style="font-size: clamp(1.4rem, 2.4vw, 1.8rem); letter-spacing: -0.02em;">
              Artículos relacionados
            </h2>
            <div class="row g-4">
              {related.map((r, i) => (
                <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay={String(i * 60)}>
                  <a href={`/blog/posts/${r.id}/`} class="related-card">
                    {r.data.image && (
                      <picture>
                        <source srcset={r.data.image.replace(/\.(jpe?g|png)$/i, '.webp')} type="image/webp" />
                        <img src={r.data.image} alt={r.data.title} width="1200" height="630" loading="lazy" />
                      </picture>
                    )}
                    <div class="related-card__body">
                      <span class="related-card__cat">{categoryLabels[r.data.category] ?? r.data.category}</span>
                      <span class="related-card__title">{r.data.title}</span>
                      <span class="related-card__desc">{r.data.description}</span>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <script>
    document
      .querySelectorAll<HTMLElement>('.blog-content > *:not(script)')
      .forEach((el) => el.setAttribute('data-aos', 'fade-up'));
  </script>
</BlogLayout>

<style>
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 0.75rem;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .eyebrow-blue {
    background: rgba(108, 172, 227, 0.12);
    color: #6cace3;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 18px rgba(108, 172, 227, 0.1);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .related-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 32px rgba(108, 172, 227, 0.18);
  }
  .related-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    display: block;
  }
  .related-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.15rem 1.25rem;
  }
  .related-card__cat {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6cace3;
    margin-bottom: 0.4rem;
  }
  .related-card__title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #1a2e4a;
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }
  .related-card__desc {
    font-size: 0.85rem;
    color: #6c757d;
    line-height: 1.6;
  }
</style>

<style is:global>
  .blog-content h2 { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; color: #1a2e4a; }
  .blog-content h3 { font-size: 1.2rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #1a2e4a; }
  .blog-content p { font-size: 1rem; line-height: 1.8; color: #6c757d; margin-bottom: 1.25rem; }
  .blog-content ul, .blog-content ol { margin-bottom: 1.25rem; color: #6c757d; line-height: 1.8; }
  .blog-content li { margin-bottom: 0.5rem; }
  .blog-content a { color: #6cace3; font-weight: 600; }
  .blog-content blockquote { border-left: 4px solid #6cace3; padding-left: 1rem; margin: 1.5rem 0; color: #5a6880; font-style: italic; }
  .blog-content .key-takeaway { background: rgba(108,172,227,0.08); border-radius: 1rem; padding: 1.25rem 1.5rem; margin: 1.5rem 0; border-left: 4px solid #6cace3; }
  .blog-content .key-takeaway p:last-child { margin-bottom: 0; }
  .blog-content .datos-clave { background: rgba(250,182,10,0.08); border-radius: 1rem; padding: 1.1rem 1.5rem; margin: 1.5rem 0; border-left: 4px solid #c98b00; }
  .blog-content .datos-clave > p:first-child { margin-bottom: 0.5rem; color: #c98b00; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .blog-content .datos-clave ul { margin-bottom: 0; }
  .blog-content .datos-clave li { font-size: 0.95rem; line-height: 1.7; }
  .blog-content img { max-width: 100%; height: auto; border-radius: 0.75rem; box-shadow: 0 6px 24px rgba(0,0,0,0.08); }
  .blog-content figure { margin: 1.75rem 0; text-align: center; }
  .blog-content figcaption { font-size: 0.85rem; color: #6c757d; margin-top: 0.6rem; }
  .blog-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .blog-content th, .blog-content td { border: 1px solid rgba(108,172,227,0.4); padding: 0.65rem 0.9rem; text-align: left; vertical-align: top; }
  .blog-content th { background: #f5f9ff; color: #1a2e4a; font-weight: 700; }
  .blog-content tbody tr:nth-child(even) { background: #fafcff; }
</style>
