      .ld-table th,
      .ld-table td {
        padding: 0.7rem 0.8rem;
      }

      .ld-table th,
      .ld-table td:first-child {
        white-space: normal;
      }

      .ld-table--facts td:first-child {
        width: 42%;
      }

      .ld-table--products th:nth-child(3),
      .ld-table--products td:nth-child(3) {
        display: none;
      }

      .ld-trust__item {
        padding: 0;
      }

      .ld-trust__inner {
        padding: 1.25rem 1.1rem;
      }

      .ld-actions .ld-btn {
        flex: 1 1 100%;
      }

      .ld-cta {
        padding: 2.6rem 1.4rem;
        border-radius: 18px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ld-btn,
