      outline: 3px solid #fab60a;
      outline-offset: 3px;
      border-radius: 6px;
    }

    @media (max-width: 1199px) {
      .ld-trust__inner {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.4rem 1rem;
      }

      .ld-trust__item + .ld-trust__item {
        border-left: 0;
      }
    }

    @media (max-width: 991px) {
      .ld-hero__grid,
      .ld-split {
        grid-template-columns: 1fr;
        gap: 2.4rem;
      }

      .ld-media {
        aspect-ratio: 16 / 9;
        max-width: 34rem;
      }
    }

    @media (max-width: 767px) {
      .ld-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 575px) {
      .ld-hero {
        padding: 3rem 0 3.2rem;
      }

      .ld-section {
        padding: 3.2rem 0;
      }

      .ld-table {
        min-width: 0;
        font-size: 0.86rem;
