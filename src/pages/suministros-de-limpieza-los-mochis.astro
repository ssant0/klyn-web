---
import Layout from "../layouts/Layout.astro";

const pageUrl = new URL(Astro.url.pathname, "https://www.klyn.com.mx").href;
const siteUrl = "https://www.klyn.com.mx";

const waMessage =
  "Hola, vengo de la página de suministros en Los Mochis. Quiero una cotización.";
const waHref = `https://wa.me/526681629654?text=${encodeURIComponent(waMessage)}`;

const destacados = [
  {
    producto: "Cloro",
    presentacion: "1 L, 3.75 L y 20 L",
    uso: "Pisos, baños y superficies de contacto",
  },
  {
    producto: "Limpiador multiusos",
    presentacion: "1 L, 5 L y 20 L · cuatro esencias",
    uso: "Mostradores, mesas y áreas comunes",
  },
  {
    producto: "Desengrasante",
    presentacion: "1 L, 3.75 L y 20 L",
    uso: "Cocinas, campanas y parrillas",
  },
  {
    producto: "Detergente líquido",
    presentacion: "1 L, 5 L y 20 L",
    uso: "Uniformes, trapos y lavandería",
  },
  {
    producto: "Papel higiénico institucional",
    presentacion: "Caja con 12 rollos",
    uso: "Baños de personal y de clientes",
  },
];

const entrega = [
  { concepto: "Cobertura", detalle: "Toda la ciudad de Los Mochis, Sinaloa" },
  { concepto: "Días de reparto", detalle: "Lunes a sábado" },
  { concepto: "Horario", detalle: "9:00 a 18:00" },
  {
    concepto: "Costo de envío",
    detalle: "Gratis en pedidos desde $500 MXN. En compras menores, $50",
  },
  {
    concepto: "Tiempo de entrega",
    detalle: "De 24 a 48 horas o la fecha que se acuerde al confirmar",
  },
  { concepto: "Facturación", detalle: "CFDI 4.0 con tus datos fiscales" },
];

const categorias = [
  {
    titulo: "Químicos de limpieza",
    texto:
      "Cloro, limpiador multiusos, desengrasante, detergente líquido, aromatizante y pinol. Presentaciones de 1 L a 20 L y garrafa de hipoclorito de 24 kg.",
    icon: "bottle",
  },
  {
    titulo: "Higiénicos e institucional",
    texto:
      "Papel higiénico por caja, toallas de manos, jabón, bolsas para basura en todos los calibres y pastillas sanitarias para baños.",
    icon: "paper",
  },
  {
    titulo: "Herramientas y equipo",
    texto:
      "Trapeadores, escobas, jaladores, cepillos, cubetas y dispensadores para uso continuo.",
    icon: "broom",
  },
  {
    titulo: "Papelería de oficina",
    texto:
      "Hoja blanca bond, rollo térmico, cinta masking, pizarrones y consumibles de impresión para la operación diaria.",
    icon: "clipboard",
  },
];

const pasos = [
  {
    titulo: "Manda tu lista",
    texto:
      "Escríbenos los productos, cantidades y presentaciones. Si no tienes la lista completa, cuéntanos qué usas y te ayudamos a armarla.",
  },
  {
    titulo: "Recibe la cotización",
    texto:
      "Te respondemos con precio, disponibilidad y costo de envío en días hábiles.",
  },
  {
    titulo: "Confirma fecha y pago",
    texto:
      "Acordamos el día de entrega dentro del horario de reparto y la forma de pago.",
  },
  {
    titulo: "Recibe y factura",
    texto:
      "Entregamos en tu negocio y emitimos CFDI 4.0 con los datos fiscales que nos compartas.",
  },
];

const faqs = [
  {
    q: "¿Entregan en mi colonia?",
    a: "Sí. Cubrimos toda la ciudad de Los Mochis. Mándanos tu dirección por WhatsApp y confirmamos el día de reparto que corresponde a tu zona.",
  },
  {
    q: "¿Cuánto cuesta el envío?",
    a: "El envío es gratis en pedidos desde $500 MXN. En compras menores el costo es de $50. No manejamos un pedido mínimo: puedes pedir desde una pieza.",
  },
  {
    q: "¿Cuánto tarda la entrega?",
    a: "De 24 a 48 horas, o en la fecha que acordemos al confirmar el pedido. Repartimos de lunes a sábado, de 9:00 a 18:00.",
  },
  {
    q: "¿Facturan?",
    a: "Sí. Emitimos CFDI 4.0. Comparte tu RFC, razón social y régimen fiscal al confirmar el pedido y te enviamos la factura por correo.",
  },
  {
    q: "¿Puedo pedir solo papelería?",
    a: "Sí. El catálogo se concentra en limpieza, pero también surtimos higiénicos, herramientas y papelería de oficina. Puedes combinar categorías en un mismo pedido.",
  },
];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: `${siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Suministros de limpieza en Los Mochis",
      item: pageUrl,
    },
  ],
};

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: "Suministros de limpieza en Los Mochis",
  serviceType:
    "Suministro de productos de limpieza, higiénicos, herramientas y papelería para negocios",
  url: pageUrl,
  provider: { "@id": `${siteUrl}/#business` },
  areaServed: {
    "@type": "City",
    name: "Los Mochis",
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: "Sinaloa",
    },
  },
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: waHref,
    servicePhone: {
      "@type": "ContactPoint",
      telephone: "+526681629654",
      contactType: "sales",
      availableLanguage: "Spanish",
    },
  },
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Suministros de limpieza en Los Mochis | Klyn",
  description:
    "Cloro, limpiador multiusos, desengrasante, higiénicos y papelería para negocios de Los Mochis. Entrega local en 24 a 48 horas y factura CFDI.",
  inLanguage: "es-MX",
  isPartOf: { "@id": `${siteUrl}/#website` },
  about: { "@id": `${pageUrl}#service` },
  breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}/assets/img/og/og-image.png`,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: "es-MX",
  isPartOf: { "@id": `${pageUrl}#webpage` },
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Layout
  title="Suministros de limpieza en Los Mochis | Klyn"
  description="Cloro, limpiador multiusos, higiénicos y papelería para negocios de Los Mochis. Entrega en 24 a 48 h, envío gratis desde $500 y factura CFDI."
>
  <Fragment slot="head-schema">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <style>
    .ld-hero {
      position: relative;
      overflow: hidden;
      padding: 4.5rem 0 4rem;
      background: linear-gradient(145deg, #0d2341 0%, #173a60 52%, #2f6ea5 100%);
      color: #fff;
    }

    .ld-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 30px 30px;
      pointer-events: none;
    }

    .ld-hero::after {
      content: '';
      position: absolute;
      top: -140px;
      right: -120px;
      width: 460px;
      height: 460px;
      border-radius: 50%;
      background: rgba(108, 172, 227, 0.22);
      filter: blur(90px);
      pointer-events: none;
    }

    .ld-hero__grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      align-items: center;
    }

    .ld-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.95rem;
      border-radius: 999px;
      background: rgba(250, 182, 10, 0.16);
      color: #fab60a;
      font-size: 0.73rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      margin-bottom: 1.4rem;
    }

    .ld-eyebrow--blue {
      background: rgba(108, 172, 227, 0.14);
      color: #2a6ea6;
    }

    .ld-eyebrow__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .ld-hero h1 {
      font-size: clamp(2.1rem, 3.9vw, 3.35rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
    }

    .ld-hl {
      white-space: nowrap;
      border-bottom: 4px solid #fab60a;
      padding-bottom: 0.02em;
    }

    .ld-hero__lead {
      font-size: 1.08rem;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.82);
      max-width: 34rem;
      margin-bottom: 1.9rem;
    }

    .ld-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 1.6rem;
    }

    .ld-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.85rem 1.7rem;
      border-radius: 999px;
      font-size: 0.98rem;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .ld-btn--gold {
      background: #fab60a;
      color: #1a2e4a;
      box-shadow: 0 6px 18px rgba(250, 182, 10, 0.28);
    }

    .ld-btn--gold:hover {
      background: #ffc93c;
      color: #1a2e4a;
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(250, 182, 10, 0.38);
    }

    .ld-btn--ghost {
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
    }

    .ld-btn--ghost:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border-color: #fff;
    }

    .ld-btn--navy {
      background: #1a2e4a;
      color: #fff;
    }

    .ld-btn--navy:hover {
      background: #24406a;
      color: #fff;
      transform: translateY(-2px);
    }

    .ld-hero__points {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.4rem;
      list-style: none;
      margin: 0;
      padding: 0;
      font-size: 0.86rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .ld-hero__points li {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .ld-hero__points svg {
      color: #fab60a;
      flex-shrink: 0;
    }

    /* Marco reservado para la foto del almacén */
    .ld-media {
      position: relative;
      aspect-ratio: 4 / 3;
      border-radius: 20px;
      border: 1px dashed rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.06);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      padding: 2rem;
      text-align: center;
      overflow: hidden;
    }

    .ld-media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(108, 172, 227, 0.18), rgba(13, 35, 65, 0.1));
      pointer-events: none;
    }

    .ld-media__icon {
      position: relative;
      color: rgba(255, 255, 255, 0.6);
    }

    .ld-media__title {
      position: relative;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      margin: 0;
      color: rgba(255, 255, 255, 0.92);
    }

    .ld-media__sub {
      position: relative;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.74);
      margin: 0;
    }

    .ld-media__tag {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 1;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
    }

    .ld-trust {
      position: relative;
      z-index: 2;
      margin-top: -2.1rem;
    }

    .ld-trust__inner {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      background: #fff;
      border: 1px solid #e6eef7;
      border-radius: 18px;
      padding: 1.5rem 1.25rem;
      box-shadow: 0 14px 40px rgba(13, 35, 65, 0.09);
    }

    .ld-trust__item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0 0.6rem;
    }

    .ld-trust__item + .ld-trust__item {
      border-left: 1px solid #edf3fa;
    }

    .ld-trust__icon {
      flex-shrink: 0;
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background: #f1f7fe;
      color: #2a6ea6;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ld-trust__label {
      font-size: 0.88rem;
      font-weight: 700;
      color: #1a2e4a;
      line-height: 1.3;
      margin: 0;
    }

    .ld-trust__text {
      font-size: 0.8rem;
      color: #5b708c;
      margin: 0.2rem 0 0;
      line-height: 1.4;
    }

    .ld-section {
      padding: 4.5rem 0;
    }

    .ld-section--tint {
      background: #f5f9ff;
    }

    .ld-section__head {
      max-width: 44rem;
      margin-bottom: 2.6rem;
    }

    .ld-section__head--center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .ld-section h2 {
      font-size: clamp(1.7rem, 3vw, 2.4rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.16;
      color: #1a2e4a;
      margin-bottom: 0.85rem;
    }

    .ld-section__lead {
      font-size: 1.02rem;
      line-height: 1.7;
      color: #5b708c;
      margin: 0;
    }

    .ld-section__lead a {
      color: #2a6ea6;
      font-weight: 600;
    }

    .ld-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .ld-card {
      background: #fff;
      border: 1px solid #e6eef7;
      border-radius: 16px;
      padding: 1.7rem;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .ld-card:hover {
      transform: translateY(-4px);
      border-color: #cfe2f4;
      box-shadow: 0 14px 32px rgba(13, 35, 65, 0.08);
    }

    .ld-card__icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #f1f7fe;
      color: #2a6ea6;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .ld-card h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1a2e4a;
      margin-bottom: 0.5rem;
    }

    .ld-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      color: #5b708c;
      margin: 0;
    }

    .ld-table-wrap {
      overflow-x: auto;
      border: 1px solid #e3ecf6;
      border-radius: 16px;
      background: #fff;
    }

    .ld-table {
      width: 100%;
      min-width: 34rem;
      border-collapse: collapse;
      font-size: 0.93rem;
    }

    .ld-table--facts {
      min-width: 0;
    }

    .ld-table--facts td:first-child {
      white-space: normal;
      width: 38%;
    }

    .ld-table caption {
      caption-side: top;
      text-align: left;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: #6b7f99;
      padding: 1rem 1.25rem 0.5rem;
    }

    .ld-table th {
      background: #1a2e4a;
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-align: left;
      padding: 0.85rem 1.25rem;
      white-space: nowrap;
    }

    .ld-table td {
      padding: 0.85rem 1.25rem;
      border-top: 1px solid #e9f1f9;
      color: #40536e;
      line-height: 1.5;
      vertical-align: top;
    }

    .ld-table tbody tr:nth-child(even) {
      background: #f8fbff;
    }

    .ld-table td:first-child {
      color: #1a2e4a;
      font-weight: 600;
      white-space: nowrap;
    }

    .ld-table-note {
      font-size: 0.86rem;
      color: #5b708c;
      margin: 0.9rem 0 0;
      line-height: 1.6;
    }

    .ld-split {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
      align-items: start;
    }

    .ld-steps {
      list-style: none;
      counter-reset: step;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.1rem;
    }

    .ld-steps li {
      counter-increment: step;
      position: relative;
      padding-left: 3.4rem;
    }

    .ld-steps li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      top: 0;
      width: 2.3rem;
      height: 2.3rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fab60a;
      color: #1a2e4a;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .ld-steps h3 {
      font-size: 1rem;
      font-weight: 700;
      color: #1a2e4a;
      margin: 0.25rem 0 0.3rem;
    }

    .ld-steps p {
      font-size: 0.92rem;
      line-height: 1.65;
      color: #5b708c;
      margin: 0;
    }

    .ld-quotes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    .ld-quote {
      background: #fff;
      border: 1px solid #e6eef7;
      border-left: 4px solid #fab60a;
      border-radius: 16px;
      padding: 1.7rem;
    }

    .ld-quote p {
      font-size: 0.94rem;
      line-height: 1.7;
      color: #33475f;
      margin: 0 0 1.1rem;
    }

    .ld-quote footer {
      font-size: 0.85rem;
      color: #5b708c;
    }

    .ld-quote strong {
      display: block;
      color: #1a2e4a;
      font-size: 0.9rem;
    }

    .ld-faq {
      max-width: 52rem;
      margin: 0 auto;
      display: grid;
      gap: 0.75rem;
    }

    .ld-faq details {
      background: #fff;
      border: 1px solid #e3ecf6;
      border-radius: 14px;
      padding: 0 1.35rem;
    }

    .ld-faq details[open] {
      border-color: #cfe2f4;
      box-shadow: 0 10px 26px rgba(13, 35, 65, 0.06);
    }

    .ld-faq summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      padding: 1.05rem 0;
      font-size: 0.98rem;
      font-weight: 700;
      color: #1a2e4a;
      list-style: none;
    }

    .ld-faq summary::-webkit-details-marker {
      display: none;
    }

    .ld-faq summary::after {
      content: '+';
      flex-shrink: 0;
      width: 1.6rem;
      height: 1.6rem;
      border-radius: 50%;
      background: #f1f7fe;
      color: #2a6ea6;
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.45;
      text-align: center;
      transition: transform 0.2s ease;
    }

    .ld-faq details[open] summary::after {
      content: '−';
    }

    .ld-faq p {
      font-size: 0.93rem;
      line-height: 1.7;
      color: #5b708c;
      margin: 0;
      padding: 0 0 1.2rem;
    }

    .ld-cta {
      position: relative;
      overflow: hidden;
      border-radius: 24px;
      padding: 3.4rem 2rem;
      text-align: center;
      background: linear-gradient(145deg, #0d2341 0%, #173a60 55%, #2f6ea5 100%);
      color: #fff;
    }

    .ld-cta::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 26px 26px;
      pointer-events: none;
    }

    .ld-cta > * {
      position: relative;
      z-index: 1;
    }

    .ld-cta h2 {
      color: #fff;
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      margin-bottom: 0.7rem;
    }

    .ld-cta p {
      color: rgba(255, 255, 255, 0.78);
      font-size: 1.02rem;
      line-height: 1.65;
      max-width: 34rem;
      margin: 0 auto 1.7rem;
    }

    .ld-cta .ld-actions {
      justify-content: center;
      margin-bottom: 0;
    }

    .ld-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .ld-links a {
      display: block;
      background: #fff;
      border: 1px solid #e6eef7;
      border-radius: 14px;
      padding: 1.15rem 1.3rem;
      color: #1a2e4a;
      font-weight: 600;
      font-size: 0.93rem;
      line-height: 1.5;
      text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .ld-links a:hover {
      border-color: #cfe2f4;
      box-shadow: 0 10px 24px rgba(13, 35, 65, 0.07);
      color: #1a2e4a;
    }

    .ld-links span {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #2a6ea6;
      margin-bottom: 0.3rem;
