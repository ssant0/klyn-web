  <!-- Main catalog + cart logic -->
  <script>
  import { config } from "../data/config";

  interface ClientVariant { key: string; label: string; options: string[]; }
  interface ClientProduct {
    id: number;
    name: string;
    category: string;
    subcategory: string;
    categoryKey: string;
    accent: "blue" | "gold";
    emoji: string;
    image: string | null;
    variants: ClientVariant[];
  }
  interface CartLine {
    key: string;      // `${id}|${opts}` — merges identical configs
    id: number;
    name: string;
    category: string;
    emoji: string;
    accent: "blue" | "gold";
    opts: string;     // formatted: "Presentación: 5L · Esencia: Lavanda" ('' = sin opciones)
    qty: number;
  }
  interface CartState { lines: CartLine[]; notes: string; }

  const PRODUCTS: ClientProduct[] = (window as any).__KLYN_PRODUCTS__ || [];
  const byId = new Map<number, ClientProduct>(PRODUCTS.map((p) => [p.id, p]));

  const CART_KEY = "klyn-cart-v1";

  // ── State ──────────────────────────────────────────────
  let cart: CartState = loadCart();
  let activeCat = '';
  let activeSub = '';
  let query     = '';

  // Sheet state
  let sheetProduct: ClientProduct | null = null;
  let sheetQty = 1;
  let sheetSel: Record<string, string> = {}; // variantKey -> chosen option

  // ── DOM ────────────────────────────────────────────────
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const searchInput   = $<HTMLInputElement>('catalogSearch');
  const searchClear   = $<HTMLButtonElement>('searchClearBtn');
  const resultsMeta   = $('resultsMeta');
  const prodGrid      = $('prodGrid');
  const noResultsMsg  = $('noResultsMsg');

  const cartFab       = $<HTMLButtonElement>('cartFab');
  const cartFabBadge  = $('cartFabBadge');
  const overlay       = $('overlay');

  const sheet         = $('productSheet');
  const sheetClose    = $<HTMLButtonElement>('sheetClose');
  const sheetMedia    = $('sheetMedia');
  const sheetSub      = $('sheetSub');
  const sheetName     = $('sheetName');
  const sheetVariants = $('sheetVariants');
  const sheetMinus    = $<HTMLButtonElement>('sheetMinus');
  const sheetPlus     = $<HTMLButtonElement>('sheetPlus');
  const sheetQtyOut   = $('sheetQty') as HTMLOutputElement;
  const sheetAddBtn   = $<HTMLButtonElement>('sheetAddBtn');

  const drawer        = $('cartDrawer');
  const drawerClose   = $<HTMLButtonElement>('drawerClose');
  const drawerClear   = $<HTMLButtonElement>('drawerClear');
  const drawerCount   = $('drawerCount');
  const drawerLines   = $('drawerLines');
  const drawerEmpty   = $('drawerEmpty');
  const drawerFoot    = $('drawerFoot');
  const drawerNotes   = $<HTMLTextAreaElement>('drawerNotes');
  const cartWaBtn     = $<HTMLAnchorElement>('cartWaBtn');
  const cartMailBtn   = $<HTMLAnchorElement>('cartMailBtn');

  const whatsappFloatBtn = document.getElementById('whatsapp-float-btn') as HTMLElement | null;

  const allCards      = Array.from(prodGrid.querySelectorAll<HTMLElement>('.pc'));
  const allFilterBtns = Array.from(document.querySelectorAll<HTMLElement>('[data-fcat]'));

  // ── Persistence ────────────────────────────────────────
  function loadCart(): CartState {
    try {
      const raw = localStorage.getItem(CART_KEY);
      if (!raw) return { lines: [], notes: '' };
      const parsed = JSON.parse(raw) as CartState;
      if (!Array.isArray(parsed.lines)) return { lines: [], notes: '' };
      // Keep only lines whose product still exists
      parsed.lines = parsed.lines.filter((l) => byId.has(l.id) && typeof l.qty === 'number' && l.qty > 0);
      parsed.notes = typeof parsed.notes === 'string' ? parsed.notes : '';
      return parsed;
    } catch {
      return { lines: [], notes: '' };
    }
  }
  function saveCart(): void {
    try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch { /* storage unavailable */ }
  }

  // ── Cart operations ────────────────────────────────────
  function cartTotal(): number {
    return cart.lines.reduce((sum, l) => sum + l.qty, 0);
  }

  function addToCart(id: number, qty: number, opts: string): void {
    const p = byId.get(id);
    if (!p) return;
    const key = `${id}|${opts}`;
    const existing = cart.lines.find((l) => l.key === key);
    if (existing) {
      existing.qty += qty;
    } else {
      cart.lines.push({ key, id, name: p.name, category: p.category, emoji: p.emoji, accent: p.accent, opts, qty });
    }
    saveCart();
    syncUI();
  }

  function setLineQty(key: string, qty: number): void {
    const line = cart.lines.find((l) => l.key === key);
    if (!line) return;
    line.qty = qty;
    if (line.qty <= 0) cart.lines = cart.lines.filter((l) => l.key !== key);
    saveCart();
    syncUI();
  }

  function removeLine(key: string): void {
    cart.lines = cart.lines.filter((l) => l.key !== key);
    saveCart();
    syncUI();
  }

  function clearCart(): void {
    cart.lines = [];
    saveCart();
    syncUI();
  }

  // Simple (no-variant) line of a product — at most one exists
  function simpleLineOf(id: number): CartLine | undefined {
    return cart.lines.find((l) => l.id === id && l.opts === '');
  }

  function productTotalQty(id: number): number {
    return cart.lines.filter((l) => l.id === id).reduce((s, l) => s + l.qty, 0);
  }

  // ── Messages (WhatsApp / Email) ────────────────────────
  function buildMessages(): { wa: string; mail: string } {
    const byCat: Record<string, CartLine[]> = {};
    cart.lines.forEach((l) => {
      if (!byCat[l.category]) byCat[l.category] = [];
      byCat[l.category].push(l);
    });

    const fmtLine = (l: CartLine) => `${l.qty}× ${l.name}${l.opts ? ` (${l.opts})` : ''}`;

    let wa = '¡Hola! Me gustaría cotizar el siguiente pedido:\n\n';
    Object.keys(byCat).forEach((cat) => {
      wa += `*${cat}*\n`;
      byCat[cat].forEach((l) => { wa += `• ${fmtLine(l)}\n`; });
      wa += '\n';
    });
    if (cart.notes.trim()) wa += `Notas: ${cart.notes.trim()}\n\n`;
    wa += 'Gracias.';

    let mail = 'Hola, me gustaría cotizar el siguiente pedido:\n\n';
    Object.keys(byCat).forEach((cat) => {
      mail += `${cat}:\n`;
      byCat[cat].forEach((l) => { mail += `• ${fmtLine(l)}\n`; });
      mail += '\n';
    });
    if (cart.notes.trim()) mail += `Notas: ${cart.notes.trim()}\n\n`;
    mail += 'Gracias.';

    return { wa, mail };
  }

  // ── UI sync (FAB, cards, drawer, links) ────────────────
  function syncUI(): void {
    const total = cartTotal();
    const hasItems = total > 0;

    // FAB
    cartFab.classList.toggle('open', hasItems);
    cartFabBadge.textContent = String(total);

    // Keep WhatsApp float above the FAB
    if (whatsappFloatBtn) {
      whatsappFloatBtn.style.bottom = hasItems ? '92px' : '24px';
    }

    // Cards
    allCards.forEach((card) => {
      const id = Number(card.dataset.id);
      const hasVariants = card.dataset.variants === '1';
      const badge = card.querySelector<HTMLElement>('[data-qty-badge]');
      const addBtn = card.querySelector<HTMLElement>('[data-add]');
      const stepper = card.querySelector<HTMLElement>('[data-stepper]');
      const stepQty = card.querySelector<HTMLElement>('[data-step-qty]');

      if (hasVariants) {
        const qty = productTotalQty(id);
        if (badge) {
          badge.textContent = String(qty);
          badge.classList.toggle('on', qty > 0);
        }
        addBtn?.classList.remove('hidden-btn');
        stepper?.classList.remove('on');
      } else {
        const line = simpleLineOf(id);
        const qty = line?.qty ?? 0;
        if (badge) badge.classList.remove('on');
        if (qty > 0) {
          addBtn?.classList.add('hidden-btn');
          stepper?.classList.add('on');
          if (stepQty) stepQty.textContent = String(qty);
        } else {
          addBtn?.classList.remove('hidden-btn');
          stepper?.classList.remove('on');
        }
      }
    });

    // Drawer
    drawerCount.textContent = String(total);
    drawerEmpty.classList.toggle('visible', !hasItems);
    drawerFoot.style.display = hasItems ? '' : 'none';
    drawerLines.style.display = hasItems ? '' : 'none';

    drawerLines.innerHTML = '';
    cart.lines.forEach((l) => {
      const row = document.createElement('div');
      row.className = 'cline';

      const thumb = document.createElement('div');
      thumb.className = `cline__thumb cline__thumb--${l.accent}`;
      thumb.textContent = l.emoji;

      const info = document.createElement('div');
      info.className = 'cline__info';
      const name = document.createElement('p');
      name.className = 'cline__name';
      name.textContent = l.name;
      info.appendChild(name);
      if (l.opts) {
        const opts = document.createElement('div');
        opts.className = 'cline__opts';
        opts.textContent = l.opts;
        info.appendChild(opts);
      }

      const right = document.createElement('div');
      right.className = 'cline__right';

      const stepper = document.createElement('div');
      stepper.className = 'cline__stepper';
      const minus = document.createElement('button');
      minus.type = 'button'; minus.textContent = '−';
      minus.setAttribute('aria-label', 'Quitar uno');
      minus.addEventListener('click', () => setLineQty(l.key, l.qty - 1));
      const out = document.createElement('output');
      out.textContent = String(l.qty);
      const plus = document.createElement('button');
      plus.type = 'button'; plus.textContent = '+';
      plus.setAttribute('aria-label', 'Agregar uno');
      plus.addEventListener('click', () => setLineQty(l.key, l.qty + 1));
      stepper.append(minus, out, plus);

      const del = document.createElement('button');
      del.type = 'button'; del.className = 'cline__del';
      del.setAttribute('aria-label', `Eliminar ${l.name}`);
      const trash = document.createElement('i');
      trash.className = 'fe fe-trash-2';
      del.appendChild(trash);
      del.addEventListener('click', () => removeLine(l.key));

      right.append(stepper, del);
      row.append(thumb, info, right);
      drawerLines.appendChild(row);
    });

    // Notes
    if (drawerNotes.value !== cart.notes) drawerNotes.value = cart.notes;

    // Links
    if (hasItems) {
      const { wa, mail } = buildMessages();
      cartWaBtn.href = `https://wa.me/526681629654?text=${encodeURIComponent(wa)}`;
      cartMailBtn.href = `mailto:${atob(config.email)}?subject=Pedido%20Klyn&body=${encodeURIComponent(mail)}`;
    }
  }

  // ── Overlay helpers ────────────────────────────────────
  function lockScroll(lock: boolean): void {
    document.body.style.overflow = lock ? 'hidden' : '';
  }
  function anyPanelOpen(): boolean {
    return sheet.classList.contains('open') || drawer.classList.contains('open');
  }
  function refreshOverlay(): void {
    overlay.classList.toggle('open', anyPanelOpen());
    lockScroll(anyPanelOpen());
  }

  // ── Product sheet ──────────────────────────────────────
  function openSheet(id: number): void {
    const p = byId.get(id);
    if (!p) return;
    sheetProduct = p;
    sheetQty = 1;
    sheetQtyOut.textContent = '1';
    sheetSel = {};
    p.variants.forEach((v) => { sheetSel[v.key] = v.options[0]; });

    sheetMedia.className = `sheet__media sheet__media--${p.accent}`;
    sheetMedia.innerHTML = '';
    if (p.image) {
      const img = document.createElement('img');
      img.src = p.image; img.alt = p.name;
      sheetMedia.appendChild(img);
    } else {
      const span = document.createElement('span');
      span.id = 'sheetEmoji';
      span.textContent = p.emoji;
      sheetMedia.appendChild(span);
    }
    sheetSub.textContent = `${p.category} · ${p.subcategory}`;
    sheetName.textContent = p.name;

    // Variant groups
    sheetVariants.innerHTML = '';
    p.variants.forEach((v) => {
      const group = document.createElement('div');
      group.className = 'vgroup';

      const label = document.createElement('div');
      label.className = 'vgroup__label';
      label.textContent = v.label;
      const small = document.createElement('small');
      small.textContent = 'Elige una';
      label.appendChild(small);
      group.appendChild(label);

      const chips = document.createElement('div');
      chips.className = 'vgroup__chips';
      v.options.forEach((opt, idx) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'vchip' + (idx === 0 ? ' on' : '');
        chip.textContent = opt;
        chip.addEventListener('click', () => {
          sheetSel[v.key] = opt;
          chips.querySelectorAll('.vchip').forEach((c) => c.classList.remove('on'));
          chip.classList.add('on');
        });
        chips.appendChild(chip);
      });
      group.appendChild(chips);
      sheetVariants.appendChild(group);
    });

    closeDrawer(false);
    sheet.classList.add('open');
    refreshOverlay();
  }

  function closeSheet(update = true): void {
    sheet.classList.remove('open');
    sheetProduct = null;
    if (update) refreshOverlay();
  }

  function sheetOptsText(): string {
    if (!sheetProduct) return '';
    return sheetProduct.variants
      .map((v) => `${v.label}: ${sheetSel[v.key]}`)
      .join(' · ');
  }

  // ── Cart drawer ────────────────────────────────────────
  function openDrawer(): void {
    closeSheet(false);
    drawer.classList.add('open');
    refreshOverlay();
  }
  function closeDrawer(update = true): void {
    drawer.classList.remove('open');
    if (update) refreshOverlay();
  }

  // ── Filter ─────────────────────────────────────────────
  function applyFilters(): void {
    const q: string    = query.toLowerCase().trim();
    let visible: number = 0;

    allCards.forEach((card) => {
      const catOk  = !activeCat || card.dataset.catkey === activeCat;
      const subOk  = !activeSub || card.dataset.sub    === activeSub;
      const nameOk = !q         || card.dataset.name!.toLowerCase().indexOf(q) !== -1;
      const show   = catOk && subOk && nameOk;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    noResultsMsg.classList.toggle('visible', visible === 0);

    if (q || activeCat || activeSub) {
      resultsMeta.textContent = `${visible} producto${visible !== 1 ? 's' : ''}`;
    } else {
      resultsMeta.textContent = '';
    }

    searchClear.classList.toggle('visible', q.length > 0);
  }

  function setFilter(cat: string, sub: string): void {
    activeCat = cat;
    activeSub = sub;

    allFilterBtns.forEach((btn) => {
      const bCat      = btn.dataset.fcat ?? '';
      const bSub      = btn.dataset.fsub ?? '';
      const match     = bCat === cat && bSub === sub;
      const isSidebar = btn.classList.contains('sidebar-btn') || btn.classList.contains('sidebar-sub');
      const isMob     = btn.classList.contains('mob-pill');
      if (isSidebar || isMob) btn.classList.toggle('is-active', match);
    });

    applyFilters();
  }

  // ── Events ─────────────────────────────────────────────

  // Grid clicks: add button / stepper / card
  prodGrid.addEventListener('click', (e) => {
    const target = e.target as Element;
    const card = target.closest<HTMLElement>('.pc');
    if (!card || card.classList.contains('hidden')) return;

    const id = Number(card.dataset.id);
    const hasVariants = card.dataset.variants === '1';

    const addBtn = target.closest('[data-add]');
    const stepBtn = target.closest<HTMLElement>('[data-step]');

    if (stepBtn) {
      e.stopPropagation();
      const delta = Number(stepBtn.dataset.step);
      const line = simpleLineOf(id);
      if (line) setLineQty(line.key, line.qty + delta);
      return;
    }

    if (addBtn) {
      e.stopPropagation();
      if (hasVariants) openSheet(id);
      else addToCart(id, 1, '');
      return;
    }

    // Card body click
    if (hasVariants) openSheet(id);
    else addToCart(id, 1, '');
  });

  // Card keyboard
  prodGrid.addEventListener('keydown', (e) => {
    const { key } = e as KeyboardEvent;
    if (key === 'Enter' || key === ' ') {
      const card = (e.target as Element).closest<HTMLElement>('.pc');
      if (card && !card.classList.contains('hidden')) {
        e.preventDefault();
        const id = Number(card.dataset.id);
        if (card.dataset.variants === '1') openSheet(id);
        else addToCart(id, 1, '');
      }
    }
  });

  // Filter buttons (sidebar + mobile strip)
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('[data-fcat]');
    if (btn) setFilter(btn.dataset.fcat ?? '', btn.dataset.fsub ?? '');
  });

  // Search
  searchInput.addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value;
    applyFilters();
  });
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    query = '';
    applyFilters();
    searchInput.focus();
  });

  // Sheet events
  sheetClose.addEventListener('click', () => closeSheet());
  sheetMinus.addEventListener('click', () => {
    sheetQty = Math.max(1, sheetQty - 1);
    sheetQtyOut.textContent = String(sheetQty);
  });
  sheetPlus.addEventListener('click', () => {
    sheetQty = Math.min(999, sheetQty + 1);
    sheetQtyOut.textContent = String(sheetQty);
  });
  sheetAddBtn.addEventListener('click', () => {
    if (!sheetProduct) return;
    addToCart(sheetProduct.id, sheetQty, sheetOptsText());
    closeSheet();
  });

  // Drawer events
  cartFab.addEventListener('click', openDrawer);
  drawerClose.addEventListener('click', () => closeDrawer());
  drawerClear.addEventListener('click', clearCart);
  drawerNotes.addEventListener('input', () => {
    cart.notes = drawerNotes.value;
    saveCart();
    syncUI(); // refresh WA/Email links with notes
  });

  // Overlay click closes whatever is open
  overlay.addEventListener('click', () => {
    closeSheet(false);
    closeDrawer(false);
    refreshOverlay();
  });

  // Escape closes panels
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && anyPanelOpen()) {
      closeSheet(false);
      closeDrawer(false);
      refreshOverlay();
    }
  });

  // Init
  applyFilters();
  syncUI();

  // Re-enable transitions after initial render (avoids slide-in flash on load)
  document.body.classList.remove('preload');
  </script>

</Layout>
