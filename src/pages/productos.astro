---
import Layout from "../layouts/Layout.astro";
import { products, type Product } from "../data/products";

const TOTAL = products.length;

// Build category metadata at build time
const categoryMeta = [
  { key: "quimicos",     label: "Químicos",     emoji: "🧴" },
  { key: "herramientas", label: "Herramientas", emoji: "🧹" },
  { key: "higienicos",   label: "Higiénicos",   emoji: "🧻" },
  { key: "papeleria",    label: "Papelería",    emoji: "📋" },
  { key: "empaques",     label: "Empaques",     emoji: "📦" },
];

// Emoji per subcategory — used as image placeholder until real photos exist
const SUB_EMOJI: Record<string, string> = {
  "Limpieza General": "🧴",
  "Desinfección y Sanitización": "🧪",
  "Desengrasantes": "🫧",
  "Lavandería": "🧺",
  "Especializados": "🪲",
  "Cuidado de Baños": "🚽",
  "Mopas y Trapeadores": "🪣",
  "Escobas y Cepillos": "🧹",
  "Contenedores": "🗑️",
  "Cubetas": "🪣",
  "Dispensadores": "🧴",
  "Paños y Fibras": "🧽",
  "Asas": "🪝",
  "Envases": "🧴",
  "Etiquetadoras": "🏷️",
  "Tapas": "🫙",
  "Bolsas": "🛍️",
  "Papel Institucional": "🧻",
  "Cuidado Personal": "🧼",
  "Desechables de Comedor": "🥤",
  "Protección Personal": "😷",
  "Protección Manual": "🧤",
  "Papel Cortado": "📄",
  "Pizarrones y Pintarrones": "📋",
  "Accesorios de Oficina": "📎",
  "Impresión": "🖨️",
  "Enmicadoras": "🗂️",
  "Temperatura": "🌡️",
};
const emojiOf = (p: Product): string => SUB_EMOJI[p.subcategory] ?? "📦";

// Build subcategory map: { catKey: [{sub, count}] }
type SubcatEntry = { sub: string; count: number };
const subcatMap: Record<string, SubcatEntry[]> = {};
for (const cm of categoryMeta) {
  const catProducts = products.filter(p => p.categoryKey === cm.key);
  const subCount: Record<string, number> = {};
  for (const p of catProducts) {
    subCount[p.subcategory] = (subCount[p.subcategory] || 0) + 1;
  }
  subcatMap[cm.key] = Object.entries(subCount).map(([sub, count]) => ({ sub, count }));
}

const catCounts: Record<string, number> = {};
for (const cm of categoryMeta) {
  catCounts[cm.key] = products.filter(p => p.categoryKey === cm.key).length;
}

// Payload for client-side cart logic (includes emoji + variants)
const clientProducts = products.map(p => ({
  id: p.id,
  name: p.name,
  category: p.category,
  subcategory: p.subcategory,
  categoryKey: p.categoryKey,
  accent: p.accent,
  emoji: emojiOf(p),
  image: p.image ?? null,
  variants: p.variants ?? [],
}));
---

<Layout
  title="Pide tus Productos de Limpieza — Klyn"
  description="Arma tu pedido como en una app de delivery: elige presentaciones, esencias y cantidades. Envíalo por WhatsApp y recibe tu cotización."
  bodyClass="preload"
>
  <script slot="head-schema" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://www.klyn.com.mx/productos#webpage",
    "url": "https://www.klyn.com.mx/productos",
    "name": "Catálogo Klyn — Pide tus productos",
    "description": "Catálogo de suministros de limpieza, herramientas y papelería para empresas. Arma tu pedido y cotiza por WhatsApp.",
    "inLanguage": "es-MX",
    "isPartOf": { "@id": "https://www.klyn.com.mx/#website" },
    "provider": { "@id": "https://www.klyn.com.mx/#business" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.klyn.com.mx/" },
        { "@type": "ListItem", "position": 2, "name": "Productos", "item": "https://www.klyn.com.mx/productos" }
      ]
    }
  }
  </script>

  <style>
    /* ── Layout ──────────────────────────────────────────── */
    .catalog-layout { display: flex; gap: 0; align-items: flex-start; }

    /* ── Sidebar ─────────────────────────────────────────── */
    .catalog-sidebar {
      width: 224px; flex-shrink: 0;
      position: sticky; top: 76px;
      max-height: calc(100vh - 90px);
      overflow-y: auto;
      padding: 20px 12px 48px;
      background: #fff;
      border-right: 1px solid #e8edf5;
      scrollbar-width: thin;
      scrollbar-color: #e4edf7 transparent;
    }
    .catalog-sidebar::-webkit-scrollbar { width: 3px; }
    .catalog-sidebar::-webkit-scrollbar-thumb { background: #dde4ef; border-radius: 4px; }

    .sidebar-label {
      font-size: 0.62rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.12em; color: #b0bbc9; padding: 0 10px; margin-bottom: 6px; margin-top: 4px;
    }
    .sidebar-btn {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; padding: 7px 10px; border-radius: 8px;
      font-size: 0.84rem; font-weight: 600; color: #4a5a6e;
      background: none; border: none; cursor: pointer; text-align: left;
      transition: background 0.14s, color 0.14s;
    }
    .sidebar-btn:hover { background: #f0f5fb; color: #1a2e4a; }
    .sidebar-btn.is-active { background: rgba(108,172,227,0.13); color: #4a94d4; font-weight: 700; }
    .sidebar-btn.is-active .s-badge { background: rgba(108,172,227,0.22); color: #4a94d4; }

    .sidebar-sub {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; padding: 5px 10px 5px 24px; border-radius: 6px;
      font-size: 0.77rem; color: #7a8ba0;
      background: none; border: none; cursor: pointer; text-align: left;
      transition: background 0.12s, color 0.12s;
    }
    .sidebar-sub:hover { background: #f5f8fc; color: #1a2e4a; }
    .sidebar-sub.is-active { color: #4a94d4; font-weight: 600; }
    .sidebar-sub.is-active .s-badge { color: #4a94d4; }

    .s-badge {
      font-size: 0.68rem; font-weight: 700; color: #aab5c3;
      background: #f0f4f8; border-radius: 999px; padding: 1px 7px; flex-shrink: 0;
    }
    .sidebar-divider { height: 1px; background: #f0f4f8; margin: 6px 0; }

    /* ── Main area ───────────────────────────────────────── */
    .catalog-main { flex: 1; min-width: 0; padding: 0 0 120px 24px; }

    /* ── Sticky tools bar (search + mobile pills) ────────── */
    .tools-bar {
      position: sticky; top: 0; z-index: 900;
      background: #f5f9ff;
      padding: 12px 0 10px;
    }

    .search-wrap { position: relative; margin-bottom: 4px; }
    .search-ico {
      position: absolute; left: 16px; top: 50%;
      transform: translateY(-50%); color: #9aa8b9; pointer-events: none; font-size: 0.95rem;
    }
    #catalogSearch {
      padding-left: 44px; padding-right: 44px; height: 48px;
      border: 2px solid #e4edf7; border-radius: 999px;
      font-size: 0.92rem; background: #fff;
      box-shadow: 0 2px 10px rgba(13,35,65,0.05);
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    #catalogSearch:focus {
      border-color: #6cace3;
      box-shadow: 0 0 0 3px rgba(108,172,227,0.15);
      outline: none;
    }
    #searchClearBtn {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: #9aa8b9; cursor: pointer;
      padding: 4px 8px; display: none; font-size: 0.9rem;
    }
    #searchClearBtn.visible { display: block; }
    #searchClearBtn:hover { color: #1a2e4a; }

    .results-meta { font-size: 0.8rem; color: #9aa8b9; margin: 10px 2px 14px; min-height: 1.1em; }

    /* ── Mobile pills (inside tools bar) ─────────────────── */
    .mobile-strip {
      display: none;
      overflow-x: auto; -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 7px; padding: 8px 0 2px;
      flex-wrap: nowrap;
    }
    .mobile-strip::-webkit-scrollbar { display: none; }
    .mob-pill {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 7px 15px; border-radius: 999px;
      font-size: 0.77rem; font-weight: 700;
      background: #fff; color: #5a6880;
      border: 2px solid #e8eef6;
      cursor: pointer; white-space: nowrap; flex-shrink: 0;
      transition: background 0.14s, color 0.14s, border-color 0.14s;
    }
    .mob-pill.is-active { background: #6cace3; color: #fff; border-color: #6cace3; }
    .mob-pill-n { font-size: 0.65rem; background: rgba(0,0,0,0.08); border-radius: 999px; padding: 0 5px; }
    .mob-pill.is-active .mob-pill-n { background: rgba(255,255,255,0.22); }

    /* ── Product grid — delivery style ───────────────────── */
    .prod-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    @media (min-width: 768px) {
      .prod-grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
    }

    /* ── Product card ────────────────────────────────────── */
    .pc {
      position: relative;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 1px 4px rgba(13,35,65,0.06);
      cursor: pointer;
      user-select: none; -webkit-user-select: none;
      transition: transform 0.17s ease, box-shadow 0.17s ease;
      overflow: hidden;
      outline: none;
      border: none;
    }
    .pc:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(13,35,65,0.10); }
    .pc:focus-visible { box-shadow: 0 0 0 3px rgba(108,172,227,0.35); }
    .pc.hidden { display: none; }

    /* Image area (placeholder until real photos) */
    .pc__img {
      position: relative;
      aspect-ratio: 4 / 3;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .pc__img--blue { background: linear-gradient(135deg, #eaf4fc 0%, #d4e9f9 100%); }
    .pc__img--gold { background: linear-gradient(135deg, #fdf4d9 0%, #fceab6 100%); }
    .pc__emoji { font-size: 2.7rem; filter: drop-shadow(0 3px 6px rgba(13,35,65,0.12)); }
    .pc__photo { width: 100%; height: 100%; object-fit: cover; }

    /* Qty badge (total items of this product in cart) */
    .pc__qty {
      position: absolute; top: 8px; right: 8px;
      min-width: 24px; height: 24px; padding: 0 6px;
      background: #16355c; color: #fff;
      border-radius: 999px;
      font-size: 0.72rem; font-weight: 800;
      display: none; align-items: center; justify-content: center;
      box-shadow: 0 2px 8px rgba(13,35,65,0.28);
    }
    .pc__qty.on { display: inline-flex; }

    .pc__body { padding: 10px 12px 12px; }
    .pc__sub {
      display: block;
      font-size: 0.6rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.07em;
      color: #aab5c3; margin-bottom: 3px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pc--blue .pc__sub { color: #6cace3; }
    .pc--gold .pc__sub { color: #c98b00; }
    .pc__name {
      font-size: 0.82rem; font-weight: 600; color: #1a2e4a;
      margin: 0 0 8px; line-height: 1.3;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden; min-height: 2.6em;
    }

    .pc__foot { display: flex; align-items: center; justify-content: space-between; min-height: 34px; }
    .pc__hint {
      font-size: 0.66rem; font-weight: 700; color: #9aa8b9;
      display: inline-flex; align-items: center; gap: 4px;
    }
    .pc__hint i { font-size: 0.72rem; }

    /* Add button — Rappi style */
    .pc__add {
      width: 34px; height: 34px; border-radius: 50%;
      background: #fff; border: 2px solid #6cace3; color: #6cace3;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(108,172,227,0.25);
      transition: background 0.15s, color 0.15s, transform 0.15s;
    }
    .pc__add:hover { background: #6cace3; color: #fff; transform: scale(1.08); }
    .pc__add svg { display: block; }
    .pc__add.hidden-btn { display: none; }

    /* Inline stepper (products without variants) */
    .pc__stepper {
      display: none; align-items: center;
      background: #6cace3; border-radius: 999px;
      box-shadow: 0 2px 8px rgba(108,172,227,0.35);
      overflow: hidden;
    }
    .pc__stepper.on { display: inline-flex; }
    .pc__stepper button {
      width: 30px; height: 34px;
      background: none; border: none; color: #fff;
      font-size: 1rem; font-weight: 800; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.12s;
    }
    .pc__stepper button:hover { background: rgba(255,255,255,0.16); }
    .pc__stepper span {
      min-width: 22px; text-align: center;
      color: #fff; font-size: 0.84rem; font-weight: 800;
    }

    /* No results */
    .no-results-msg { display: none; grid-column: 1 / -1; text-align: center; padding: 56px 16px; }
    .no-results-msg.visible { display: block; }

    /* ── Floating cart button (FAB) ──────────────────────── */
    .cart-fab {
      position: fixed; bottom: 18px; left: 50%; z-index: 9980;
      transform: translateX(-50%) translateY(140%);
      visibility: hidden;
      display: inline-flex; align-items: center; gap: 10px;
      height: 54px; padding: 0 24px;
      background: #16355c; color: #fff;
      border: none; border-radius: 999px;
      font-size: 0.92rem; font-weight: 800;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(13,35,65,0.35);
      transition: transform 0.3s cubic-bezier(0.34,1.3,0.64,1), background 0.15s, visibility 0s linear 0.3s;
      white-space: nowrap;
    }
    .cart-fab.open {
      transform: translateX(-50%) translateY(0);
      visibility: visible;
      transition: transform 0.3s cubic-bezier(0.34,1.3,0.64,1), background 0.15s, visibility 0s linear 0s;
    }
    .cart-fab:hover { background: #1e4a7c; }
    .cart-fab i { font-size: 1.05rem; }
    .cart-fab-badge {
      min-width: 26px; height: 26px; padding: 0 7px;
      background: #fab60a; color: #16355c;
      border-radius: 999px;
      font-size: 0.8rem; font-weight: 800;
      display: inline-flex; align-items: center; justify-content: center;
    }

    /* ── Shared overlay ──────────────────────────────────── */
    .overlay {
      position: fixed; inset: 0; z-index: 10000;
      background: rgba(13,35,65,0.5);
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .overlay.open { opacity: 1; pointer-events: auto; }

    /* ── Product bottom sheet ────────────────────────────── */
    .sheet {
      position: fixed; z-index: 10001;
      left: 0; right: 0; bottom: 0;
      background: #fff;
      border-radius: 22px 22px 0 0;
      max-height: 92vh;
      display: flex; flex-direction: column;
      transform: translateY(105%);
      visibility: hidden;
      transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), visibility 0s linear 0.32s;
      box-shadow: 0 -12px 44px rgba(13,35,65,0.25);
    }
    .sheet.open {
      transform: translateY(0);
      visibility: visible;
      transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), visibility 0s linear 0s;
    }

    .sheet__handle {
      width: 42px; height: 5px; border-radius: 999px;
      background: #e0e7f0; margin: 10px auto 4px; flex-shrink: 0;
    }
    .sheet__close {
      position: absolute; top: 14px; right: 14px; z-index: 2;
      width: 34px; height: 34px; border-radius: 50%;
      background: rgba(255,255,255,0.92); border: none;
      color: #1a2e4a; font-size: 0.9rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 10px rgba(13,35,65,0.18);
      transition: background 0.14s;
    }
    .sheet__close:hover { background: #fff; }

    .sheet__media {
      position: relative; flex-shrink: 0;
      height: 150px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 22px 22px 0 0;
      overflow: hidden;
    }
    .sheet__media--blue { background: linear-gradient(135deg, #dff0fc 0%, #bcdffa 100%); }
    .sheet__media--gold { background: linear-gradient(135deg, #fdf0c8 0%, #fce39a 100%); }
    .sheet__media span { font-size: 4.2rem; filter: drop-shadow(0 5px 12px rgba(13,35,65,0.15)); }
    .sheet__media img { width: 100%; height: 100%; object-fit: cover; }

    .sheet__body { padding: 18px 20px 12px; overflow-y: auto; flex: 1; }
    .sheet__sub {
      font-size: 0.64rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.09em; color: #9aa8b9; margin-bottom: 2px;
    }
    .sheet__name { font-size: 1.2rem; font-weight: 800; color: #1a2e4a; margin: 0 0 6px; letter-spacing: -0.01em; }
    .sheet__tag {
      display: inline-block; font-size: 0.7rem; font-weight: 700;
      color: #4a94d4; background: rgba(108,172,227,0.12);
      border-radius: 999px; padding: 3px 11px; margin-bottom: 4px;
    }

    .sheet__footer {
      flex-shrink: 0;
      display: flex; align-items: center; gap: 12px;
      padding: 14px 20px calc(14px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid #eef3f8;
      background: #fff;
    }
    .qty-stepper {
      display: inline-flex; align-items: center;
      border: 2px solid #e4edf7; border-radius: 999px; overflow: hidden;
      flex-shrink: 0;
    }
    .qty-stepper button {
      width: 40px; height: 46px;
      background: none; border: none;
      font-size: 1.15rem; font-weight: 800; color: #4a94d4; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.12s;
    }
    .qty-stepper button:hover { background: #f0f5fb; }
    .qty-stepper output {
      min-width: 30px; text-align: center;
      font-size: 0.95rem; font-weight: 800; color: #1a2e4a;
    }
    .sheet__add {
      flex: 1; height: 50px;
      background: #6cace3; color: #fff;
      border: none; border-radius: 999px;
      font-size: 0.92rem; font-weight: 800;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(108,172,227,0.4);
      transition: background 0.14s, transform 0.14s;
    }
    .sheet__add:hover { background: #5a9bd8; transform: translateY(-1px); }

    /* ── Cart drawer ─────────────────────────────────────── */
    .drawer {
      position: fixed; z-index: 10001;
      left: 0; right: 0; bottom: 0;
      height: 92vh;
      background: #fff;
      border-radius: 22px 22px 0 0;
      display: flex; flex-direction: column;
      transform: translateY(105%);
      visibility: hidden;
      transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), visibility 0s linear 0.32s;
      box-shadow: 0 -12px 44px rgba(13,35,65,0.25);
    }
    .drawer.open {
      transform: translateY(0);
      visibility: visible;
      transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), visibility 0s linear 0s;
    }

    .drawer__head {
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 20px 12px;
      border-bottom: 1px solid #eef3f8;
    }
    .drawer__title { font-size: 1.1rem; font-weight: 800; color: #1a2e4a; margin: 0; display: flex; align-items: center; gap: 9px; }
    .drawer__title span.n {
      background: #6cace3; color: #fff; border-radius: 999px;
      min-width: 24px; height: 24px; padding: 0 6px;
      font-size: 0.74rem; font-weight: 800;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .drawer__head-actions { display: flex; align-items: center; gap: 4px; }
    .drawer__clear {
      background: none; border: none; color: #9aa8b9;
      font-size: 0.78rem; font-weight: 700; cursor: pointer;
      padding: 6px 10px; border-radius: 8px;
      transition: color 0.13s, background 0.13s;
    }
    .drawer__clear:hover { color: #d9534f; background: #fdf0f0; }
    .drawer__close {
      width: 34px; height: 34px; border-radius: 50%;
      background: #f0f5fb; border: none; color: #1a2e4a;
      font-size: 0.9rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.14s;
    }
    .drawer__close:hover { background: #e2ecf6; }

    .drawer__lines { flex: 1; overflow-y: auto; padding: 8px 20px; }

    .drawer__empty {
      flex: 1; display: none;
      flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 40px 24px;
    }
    .drawer__empty.visible { display: flex; }

    .drawer__foot {
      flex-shrink: 0;
      padding: 12px 20px calc(16px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid #eef3f8;
      background: #fff;
    }
    .drawer__notes {
      width: 100%; resize: none;
      border: 2px solid #e4edf7; border-radius: 12px;
      font-size: 0.82rem; padding: 10px 14px;
      color: #1a2e4a; background: #fbfdff;
      transition: border-color 0.15s;
      margin-bottom: 10px;
      font-family: inherit;
    }
    .drawer__notes:focus { border-color: #6cace3; outline: none; }
    .drawer__cta { display: flex; gap: 10px; }
    .drawer__cta .btn-wa {
      flex: 1; height: 50px;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: #25d366; color: #fff;
      border-radius: 999px; border: none;
      font-size: 0.9rem; font-weight: 800; text-decoration: none;
      box-shadow: 0 6px 18px rgba(37,211,102,0.35);
      transition: background 0.14s, transform 0.14s;
    }
    .drawer__cta .btn-wa:hover { background: #1fb857; transform: translateY(-1px); }
